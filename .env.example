# Copy to .env and fill in what you have. Every key is OPTIONAL — sources
# without a key are skipped with a message, never a failure. The six ATS
# sources (Greenhouse, Lever, Ashby, SmartRecruiters, Workable, Workday) need
# no credentials at all and provide the bulk of the coverage.

# Identifies your traffic to the public APIs. Please set a real address.
JOBSCRAPE_CONTACT=you@example.com

# --- Database (PostgreSQL) -------------------------------------------------
# The archive. Defaults to a local "jobscrape" database with no auth if unset.
DATABASE_URL=postgresql+psycopg2:///jobscrape
# A SEPARATE database for the test suite — never point this at DATABASE_URL,
# tests truncate/roll back freely.
JOBSCRAPE_TEST_DATABASE_URL=postgresql+psycopg2:///jobscrape_test
JOBSCRAPE_DB_POOL_SIZE=5
JOBSCRAPE_DB_MAX_OVERFLOW=10
# Hours a posting may be absent from a successful fetch before it's closed.
# Boards paginate inconsistently under load; closing on the first absence
# would wrongly close postings that are still live.
JOBSCRAPE_CLOSURE_GRACE_HOURS=48

# --- Observability ----------------------------------------------------------
# "text" (human-readable, default) or "json" (one object per line).
JOBSCRAPE_LOG_FORMAT=text
JOBSCRAPE_LOG_LEVEL=INFO

# --- Optional API keys (all free to obtain) -------------------------------
# Every source below is already implemented and simply skipped until its key is
# present. Nothing else breaks without them.

# LinkedIn + Indeed + Glassdoor + ZipRecruiter listings, aggregated legally.
# This is the compliant alternative to scraping those sites.
#   https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# The free tier is ~200 requests/month, so JSEARCH_MAX_REQUESTS caps how many a
# single run may spend. Responses are cached for a week.
RAPIDAPI_KEY=
JSEARCH_MAX_REQUESTS=6

# Federal jobs: https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# Broad SMB coverage: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Aggregator breadth: https://jooble.org/api/about
JOOBLE_API_KEY=

# Indeed's official partner API: https://www.indeed.com/publisher
# If set, the Indeed adapter uses this instead of scraping.
INDEED_PUBLISHER_ID=

# --- Politeness / performance tuning --------------------------------------
JOBSCRAPE_CONCURRENCY=16
JOBSCRAPE_PER_HOST_CONCURRENCY=4
JOBSCRAPE_PER_HOST_DELAY=0.25
JOBSCRAPE_TIMEOUT=45
JOBSCRAPE_MAX_RETRIES=4
JOBSCRAPE_CACHE=1
JOBSCRAPE_CACHE_TTL=21600
JOBSCRAPE_CC_COLLECTIONS=3

# --- Blocked employers ----------------------------------------------------
# Never collect postings from these companies, ON TOP OF the built-in list in
# filters.BLOCKED_COMPANIES (Amazon, Microsoft, Apple, Coinbase, Airbnb,
# UnitedHealth Group, Stripe, PayPal). Comma-separated, written however you
# like — matching normalises both sides, so "Acme, Inc." and "acme" are one
# entry. EXACT match, never a prefix: blocking "apple" leaves "Apple Roofing"
# and "Appletree Dental" alone.
JOBSCRAPE_BLOCKED_COMPANIES=

# --- Dashboard admin session ------------------------------------------------
# The dashboard has no login on any route by default (see docs/DOCKER.md).
# Set this to turn on a lightweight admin/other-visitor distinction: whoever
# enters this passcode at /admin-login gets a long-lived cookie unlocking
# Schedule, Runs, Coverage's Validate button, and the rest of Settings.
# Every other visitor can still see every page, but those controls render
# blurred and disabled, not hidden — the one thing any visitor can do is add
# or remove entries in the blocked-companies list above. Blank (the default)
# means everyone is admin, same as before this existed.
JOBSCRAPE_ADMIN_PASSCODE=

# --- Per-source pagination depth ------------------------------------------
# Workday: an empty search enumerates a whole board (far better than keyword
# search), paginated 20 at a time. 1000 = up to 50 list requests for the very
# largest employers, and costs nothing on boards smaller than the cap.
JOBSCRAPE_WORKDAY_MAX_PER_BOARD=1000
# All three were verified to actually bind — the source still had more to give
# when the limit stopped us. Measured on a full sweep: Jooble sat exactly on its
# 30-page ceiling while reporting ~196,000 matches for a single term (and keeps
# 83% of what it returns, the best ratio of any source here); Himalayas returned
# 2,999 against a ceiling of 3,000.
JOBSCRAPE_HIMALAYAS_MAX_PAGES=300
JOOBLE_MAX_PAGES=60
# Adzuna is NOT paged deeper. Its free tier is quota-limited per day, so what
# binds is the total call budget, divided across the search terms — widening
# DEFAULT_QUERIES re-spreads this spend instead of multiplying it. 220 is what
# the old fixed 20-pages x 11-terms already cost.
JOBSCRAPE_ADZUNA_MAX_PAGES=20
JOBSCRAPE_ADZUNA_CALL_BUDGET=220

# --- Apify: Indeed and LinkedIn postings ----------------------------------
# The only working route to those two. The restricted scrapers in
# sources/restricted/ are blocked by anti-bot defences, and JSearch — written
# as the compliant alternative — has produced zero rows because its provider
# returns 404 for every path.
#
# This is the ONLY thing `apify-pull` needs. `scripts/schedule.sh`'s daily leg
# calls it automatically (`apify-pull --last 3`) — no endpoint, no public
# route, nothing else to deploy. Leave it blank and that step logs a line and
# skips; nothing else in the schedule is affected.
#
#   apify.com -> Settings -> Integrations -> Personal API token
APIFY_TOKEN=
# Only needed if you ALSO run `jobscrape webhook` — a separate, opt-in route
# for push delivery instead of the scheduled pull above. Shared secret Apify
# must present, as an X-Apify-Secret header or the last path segment
# (https://your.host/apify/<secret>). Apify offers no request signing, so this
# is the only authentication available; the receiver refuses to start without
# it, since it is meant to be publicly reachable.
APIFY_WEBHOOK_SECRET=
# Overridable so a fork or a pinned version needs no code change.
APIFY_INDEED_ACTOR=cheap_scraper~indeed-job-scraper
APIFY_LINKEDIN_ACTOR=cheap_scraper~linkedin-job-scraper
APIFY_PAGE_SIZE=500

# --- JobRight -------------------------------------------------------------
# Only needed for `jobright-fetch`, which needs the `jobright` extra
# (pip install '.[jobright]') and a real Chrome install. Manual/local only —
# never part of the Docker image or the automated schedule. Your normal
# JobRight.ai login.
JOBRIGHT_EMAIL=
JOBRIGHT_PASSWORD=
# Your installed Chrome's major version (chrome://settings/help), so
# undetected-chromedriver patches a matching driver instead of the latest
# one. Blank auto-detects — and risks a version mismatch if that's ahead of
# what's actually installed.
JOBRIGHT_CHROME_VERSION=

# --- Render sync ------------------------------------------------------------
# `render-sync` pushes new/updated/closed postings into a separate Postgres
# database (Render) a website reads from directly — see
# jobscrape/render_sync.py. Leave blank to skip; nothing else is affected.
# Needs Render's EXTERNAL connection string (not the internal one — this
# doesn't run inside Render's own network) with sslmode=require appended,
# e.g. postgresql://user:pass@host.render.com/db?sslmode=require
RENDER_DATABASE_URL=
